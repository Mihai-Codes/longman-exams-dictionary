// Main process entry point - Node.js backend for the Grok desktop client.
//
// The glaze CLI runtime handles framework wiring (IPC server, native bridge,
// lifecycle, signal handlers) before this file runs.

import { app, logger } from "@glaze/core/backend";

import { registerHandlers } from "./handlers/index.js";
import { openSettingsWindow } from "./windows/settings-window.js";
import { openImportCookiesWindow } from "./windows/import-cookies-window.js";
import {
  createGrokWindow,
  showWindow,
  toggleVisibility,
  newChat,
  reload,
  zoomIn,
  zoomOut,
  zoomReset,
  printPage,
  toggleFind,
  clearCacheAndReload,
} from "./grok/grok-window.js";
import { buildAppMenu } from "./grok/menu.js";
import { createTray } from "./grok/tray.js";
import {
  registerGlobalShortcut,
  unregisterGlobalShortcut,
  applyLaunchAtLogin,
} from "./grok/shortcuts.js";
import { getPrefs } from "./grok/settings-store.js";
import { maybePromptMediaOnFirstLaunch } from "./grok/media.js";

// ipcMain is already wired to the IPC server by the runtime bootstrap.
registerHandlers();

const openSettings = () => void openSettingsWindow();
const openImportCookies = () => void openImportCookiesWindow();

// Single-instance: focus the existing window instead of launching a second app.
const gotLock = app.requestSingleInstanceLock();
if (!gotLock) {
  app.quit();
} else {
  app.on("second-instance", () => showWindow());

  // Keep running in the menu bar when the window is closed (macOS convention).
  app.on("window-all-closed", () => {
    // Intentionally do not quit; the tray keeps the app alive.
  });

  app.on("activate", () => showWindow());

  app.on("will-quit", () => {
    unregisterGlobalShortcut();
  });

  app
    .whenReady()
    .then(async () => {
      const prefs = getPrefs();
      applyLaunchAtLogin(prefs.launchAtLogin);

      buildAppMenu({
        newChat,
        reload,
        zoomIn,
        zoomOut,
        zoomReset,
        printPage,
        toggleFind,
        openSettings,
        openImportCookies,
        clearCacheAndReload: () => void clearCacheAndReload(),
      });

      createTray({ newChat, toggleVisibility, openSettings });

      await createGrokWindow();

      if (prefs.globalShortcut) {
        await registerGlobalShortcut(prefs.globalShortcut, () => toggleVisibility());
      }

      await maybePromptMediaOnFirstLaunch();
    })
    .catch((error) => logger.error("main", "Startup failed", error as Error));
}
